{
  "spec_version": "0.1",
  "service": {
    "id": "social.joinmastodon.mastodon",
    "name": "Mastodon",
    "version": "4"
  },
  "requirements": [
    {
      "id": "memory",
      "path": "capabilities.compute.memory_mib",
      "op": "gte",
      "value": 8192,
      "severity": "required"
    },
    {
      "id": "postgres",
      "path": "capabilities.databases.postgresql",
      "op": "version_gte",
      "value": "15",
      "severity": "required"
    },
    {
      "id": "activitypub",
      "path": "capabilities.federation.activitypub",
      "op": "eq",
      "value": true,
      "severity": "required"
    },
    {
      "id": "webfinger",
      "path": "capabilities.federation.webfinger",
      "op": "eq",
      "value": true,
      "severity": "required"
    },
    {
      "id": "snapshots",
      "path": "capabilities.storage.snapshots",
      "op": "eq",
      "value": true,
      "severity": "preferred"
    }
  ]
}
