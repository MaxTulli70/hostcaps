{
  "spec_version": "0.1",
  "service": {
    "id": "com.nextcloud.server",
    "name": "Nextcloud",
    "version": "30"
  },
  "requirements": [
    {
      "id": "nixos",
      "path": "capabilities.runtime.nixos",
      "op": "eq",
      "value": true,
      "severity": "required"
    },
    {
      "id": "memory",
      "path": "capabilities.compute.memory_mib",
      "op": "gte",
      "value": 4096,
      "severity": "required"
    },
    {
      "id": "storage",
      "path": "capabilities.storage.persistent_gib",
      "op": "gte",
      "value": 100,
      "severity": "required"
    },
    {
      "id": "database",
      "path": "capabilities.databases.postgresql",
      "op": "version_gte",
      "value": "15",
      "severity": "required"
    },
    {
      "id": "snapshots",
      "path": "capabilities.storage.snapshots",
      "op": "eq",
      "value": true,
      "severity": "preferred"
    }
  ]
}
